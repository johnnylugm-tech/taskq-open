  "quality_targets": {
    "max_complexity": 10,
    "min_coverage": 100,
    "max_coupling": 0.3
  },
  "nfr_dimension_mapping": {
    "NFR-01": "performance",
    "NFR-02": "security",
    "NFR-03": "error_handling",
    "NFR-04": "security",
    "NFR-05": "documentation",
    "NFR-06": "architecture_constraints",
    "NFR-07": "license_compliance",
    "NFR-08": "mutation_testing",
